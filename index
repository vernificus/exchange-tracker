  <script>
    // --- 1. Inline PWA Manifest ---
    const manifest = {
      name: "Exchange Tracker",
      short_name: "Exchanges",
      start_url: "./",
      display: "standalone",
      background_color: "#f8fafc",
      theme_color: "#0f172a",
