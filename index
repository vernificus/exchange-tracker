        return saved ? JSON.parse(saved) : [];
      });

      useEffect(() => {
        localStorage.setItem('pwaExchangeFoods_v2', JSON.stringify(foods));
      }, [foods]);

      const today = new Date().toDateString();
      const todaysFoods = useMemo(() => foods.filter(f => f.date === today), [foods, today]);

      const getMealTotals = (mealName) => {
        const mealFoods = todaysFoods.filter(f => f.meal === mealName);
        let totals = { 'Starch/Carb': 0, 'Protein (Lean)': 0, 'Vegetable': 0, 'Fruit': 0, 'Fat': 0, 'Milk (Low-fat)': 0 };
        mealFoods.forEach(f => {
          categories.forEach(cat => totals[cat] += (f.exchanges[cat] || 0));
        });
        return totals;
      };

      const getDailyTotals = () => {
        let totals = { 'Starch/Carb': 0, 'Protein (Lean)': 0, 'Vegetable': 0, 'Fruit': 0, 'Fat': 0, 'Milk (Low-fat)': 0 };
        todaysFoods.forEach(f => {
          categories.forEach(cat => totals[cat] += (f.exchanges[cat] || 0));
        });
        return totals;
