      Lunch: { 'Starch/Carb': "3-4", 'Protein (Lean)': "3-4", 'Vegetable': "2-3", 'Fruit': "1", 'Fat': "1-3", 'Milk (Low-fat)': "1" },
      Dinner: { 'Starch/Carb': "3-4", 'Protein (Lean)': "4-5", 'Vegetable': "2-3", 'Fruit': "1", 'Fat': "2-3", 'Milk (Low-fat)': "0" },
      Snack: { 'Starch/Carb': "2", 'Protein (Lean)': "0-1", 'Vegetable': "0", 'Fruit': "0", 'Fat': "0", 'Milk (Low-fat)': "0" }
