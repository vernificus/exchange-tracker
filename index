            protein: parseFloat(macros.protein)||0, 
            fat: parseFloat(macros.fat)||0 
          },
          exchanges: allocations
        });

        setName('');
        setMacros({ carbs: '', protein: '', fat: '' });
      };

      const adjustAllocation = (cat, amount) => {
        setAllocations(prev => ({
          ...prev,
          [cat]: Math.max(0, prev[cat] + amount)
        }));
      };

      return (
        <div className="space-y-6">
          <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-100">
            <h2 className="font-bold text-lg mb-4 text-slate-800">Add Food Item</h2>
            
            <div className="space-y-4">
              <select 
                value={meal} 
                onChange={e => setMeal(e.target.value)}
                className="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none font-medium"
              >
                <option>Breakfast</option>
                <option>Lunch</option>
                <option>Dinner</option>
                <option>Snack</option>
              </select>

              <input 
                type="text" 
                placeholder="Food Name (e.g., Apple, Chicken)" 
                value={name}
                onChange={e => setName(e.target.value)}
                className="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none"
              />

              <div className="grid grid-cols-3 gap-3">
                <div>
                  <label className="block text-[11px] font-bold text-slate-500 mb-1 ml-1 uppercase">Carbs (g)</label>
                  <input type="number" placeholder="0" value={macros.carbs} onChange={e => setMacros({...macros, carbs: e.target.value})} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-center" />
                </div>
                <div>
                  <label className="block text-[11px] font-bold text-slate-500 mb-1 ml-1 uppercase">Protein (g)</label>
                  <input type="number" placeholder="0" value={macros.protein} onChange={e => setMacros({...macros, protein: e.target.value})} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-center" />
                </div>
                <div>
                  <label className="block text-[11px] font-bold text-slate-500 mb-1 ml-1 uppercase">Fat (g)</label>
                  <input type="number" placeholder="0" value={macros.fat} onChange={e => setMacros({...macros, fat: e.target.value})} className="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-center" />
                </div>
              </div>

              <div className="bg-slate-900 rounded-xl p-4 mt-4 text-white">
                <p className="text-[11px] text-slate-400 mb-3 text-center uppercase tracking-wider font-bold">Assign to Categories</p>
                <div className="space-y-2">
                  {categories.map(cat => (
                    <div key={cat} className="flex justify-between items-center bg-slate-800 px-3 py-2 rounded-lg">
                      <span className="text-[13px] font-medium leading-tight">{cat}</span>
                      <div className="flex items-center gap-3">
                        <button onClick={() => adjustAllocation(cat, -0.5)} className="bg-slate-700 p-1.5 rounded-full text-slate-300"><Icons.Minus /></button>
                        <span className="w-6 text-center font-bold text-base">{allocations[cat]}</span>
                        <button onClick={() => adjustAllocation(cat, 0.5)} className="bg-blue-600 p-1.5 rounded-full text-white"><Icons.Plus /></button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <button 
                onClick={handleAdd}
                className="w-full bg-blue-600 text-white font-bold py-3.5 rounded-xl mt-4 active:bg-blue-700 transition"
              >
                Save Food
              </button>
            </div>
          </div>

          <div>
            <h2 className="font-bold text-lg mb-3 text-slate-800 ml-1">Today's Log</h2>
            {['Breakfast', 'Lunch', 'Dinner', 'Snack'].map(mealName => {
              const mealFoods = todaysFoods.filter(f => f.meal === mealName);
              if (mealFoods.length === 0) return null;
              
              return (
                <div key={mealName} className="mb-4 bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
                  <div className="bg-slate-100 px-4 py-2 font-bold text-slate-700 text-sm">{mealName}</div>
                  <div className="divide-y divide-slate-100">
                    {mealFoods.map(food => (
                      <div key={food.id} className="p-4 flex justify-between items-start">
                        <div>
                          <p className="font-bold text-slate-800">{food.name}</p>
                          <p className="text-xs text-slate-500 mt-1">
                            {food.macros.carbs}g C • {food.macros.protein}g P • {food.macros.fat}g F
                          </p>
                          <div className="flex flex-wrap gap-1 mt-2">
                            {categories.map(cat => food.exchanges[cat] > 0 && (
                              <span key={cat} className="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200">
                                {food.exchanges[cat]} {cat}
                              </span>
                            ))}
                          </div>
                        </div>
                        <button onClick={() => deleteFood(food.id)} className="text-red-400 p-2"><Icons.Trash /></button>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
            {todaysFoods.length === 0 && (
              <p className="text-center text-slate-400 py-8 italic text-sm">No foods logged today yet.</p>
            )}
          </div>
        </div>
      );
    };

    // --- Summary Tab ---
    const SummaryTab = ({ dailyTotals, getMealTotals }) => {
      const isMet = (current, goalString) => {
        const minGoal = parseFloat(goalString.split('-')[0]);
        return current >= minGoal;
      };

      return (
        <div className="space-y-6">
          <div className="bg-slate-900 text-white rounded-2xl shadow-sm p-5">
            <h2 className="text-lg font-bold mb-4 border-b border-slate-700 pb-2">Total Daily Progress</h2>
            <div className="grid grid-cols-2 gap-3">
              {categories.map(cat => {
                const met = isMet(dailyTotals[cat], dailyGoals[cat]);
                return (
                  <div key={cat} className="bg-slate-800 p-3 rounded-xl flex items-center justify-between border border-slate-700">
                    <div>
                      <div className="text-[11px] text-slate-400 font-bold leading-tight max-w-[80px]">{cat}</div>
                      <div className="text-[10px] text-slate-500 mt-1">Goal: {dailyGoals[cat]}</div>
                    </div>
                    <div className={`text-2xl font-bold ${met ? 'text-green-400' : 'text-white'}`}>
                      {dailyTotals[cat]}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <h2 className="font-bold text-lg mb-2 text-slate-800 ml-1 mt-6">Meal Breakdowns</h2>
          {['Breakfast', 'Lunch', 'Dinner', 'Snack'].map(mealName => {
            const totals = getMealTotals(mealName);
            const goals = mealGoals[mealName];
            
            return (
              <div key={mealName} className="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden mb-4">
                <div className="bg-slate-100 px-4 py-2 font-bold text-slate-700 flex justify-between">
                  <span>{mealName}</span>
                </div>
                <div className="p-4 grid grid-cols-3 gap-y-5 gap-x-2">
                  {categories.map(cat => {
                    const met = isMet(totals[cat], goals[cat]);
                    return (
                      <div key={cat} className="text-center">
                        <div className="text-[10px] font-bold text-slate-500 uppercase h-8 flex items-center justify-center leading-tight">
                          {cat}
                        </div>
                        <div className={`text-xl font-bold ${met && totals[cat] > 0 ? 'text-green-600' : 'text-slate-800'}`}>
                          {totals[cat]}
                        </div>
                        <div className="text-[10px] text-slate-400 mt-1">Tgt: {goals[cat]}</div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      );
    };

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>


