              <Icons.List />
              <span className="text-xs mt-1 font-medium">Log Food</span>
            </button>
            <button 
              onClick={() => setActiveTab('summary')}
              className={`flex flex-col items-center flex-1 ${activeTab === 'summary' ? 'text-blue-600' : 'text-slate-400'}`}
